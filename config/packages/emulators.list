# Emulators: libretro cores in one RetroArch setup (same menu, hotkeys and
# save states for every system). Heavier standalone emulators are one-click
# installs from ES-DE (Mangmi Air X -> Install ...), see
# system/tools/usr/share/mangmi/optional.list.
mangmi-emulators
retroarch
retroarch-assets-ozone
libretro-core-info
libretro-shaders-slang

# --- libretro cores from Arch Linux ARM ---------------------------------------------
libretro-snes9x
libretro-nestopia
libretro-mesen
libretro-mesen-s
libretro-gambatte
libretro-sameboy
libretro-mgba
libretro-genesis-plus-gx
libretro-picodrive
libretro-beetle-pce-fast
libretro-beetle-supergrafx
libretro-mupen64plus-next
libretro-parallel-n64
libretro-flycast
libretro-scummvm

# --- extra cores (libretro buildbot, aarch64) ---------------------------------------
mangmi-cores

# --- data -------------------------------------------------------------------------------
# PPSSPP fonts/atlas for the libretro core (~/BIOS/PPSSPP -> /usr/share/ppsspp/assets)
ppsspp-assets
