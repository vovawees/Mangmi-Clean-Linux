#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Creates the per-session launcher shims in $XDG_RUNTIME_DIR/mangmi/wrap.
# ES-DE finds emulators through $PATH, the shims come first, so every game
# goes through mangmi-run (games.slice, big cores, performance profile).
# Only emulators that are actually installed get a shim.
set -u
wrap="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mangmi/wrap"
rm -rf "$wrap"
mkdir -p "$wrap"
syspath=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '/mangmi/wrap$' | paste -sd:)
while IFS=: read -r name target; do
  [[ -z $name || $name == \#* ]] && continue
  real=$(PATH=$syspath command -v "${target:-$name}") || continue
  printf '#!/bin/sh\nexec mangmi-run --auto -- %q "$@"\n' "$real" >"$wrap/$name"
  chmod +x "$wrap/$name"
done </usr/share/mangmi/emulators.list
