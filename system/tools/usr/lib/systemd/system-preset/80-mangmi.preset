# Mangmi Clean Linux services (first match wins, so this file overrides
# 90-systemd.preset).
enable mangmi-hwd.service
enable mangmi-firstboot.service
enable mangmi-pacman-init.service
enable inputplumber.service
enable pd-mapper.service
enable rmtfs.service
enable tqftpserv.service
enable NetworkManager.service
enable bluetooth.service
enable systemd-timesyncd.service
enable fstrim.timer

# NetworkManager (with iwd) owns the network and writes /etc/resolv.conf.
# NetworkManager-wait-online comes along with it (Also=), but it only runs
# when a unit wants network-online.target (mangmi-update), never at boot.
disable systemd-networkd*
disable systemd-network-generator.service
disable systemd-resolved*
# not used on this device: no homed users, TPM, system/config extensions,
# sysupdate, metrics/report endpoints or audit. OpenABL reads the boot
# entries itself (there is no systemd-boot to update), so the ESP stays
# unmounted during boot (mangmi-esp mounts it for updates).
disable systemd-homed*
disable systemd-tpm2-clear.service
disable systemd-sysext*
disable systemd-confext*
disable systemd-sysupdate*
disable systemd-report*
disable systemd-journalctl-metrics.socket
disable systemd-journald-audit.socket
disable systemd-mountfsd.socket
disable systemd-nsresourced.socket
disable systemd-boot-update.service
