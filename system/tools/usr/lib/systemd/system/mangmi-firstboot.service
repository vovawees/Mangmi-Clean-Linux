[Unit]
Description=Mangmi Clean Linux first boot setup (grow storage, apply mangmi-setup.txt)
ConditionPathExists=!/var/lib/mangmi/firstboot.done
After=local-fs.target boot.mount
Before=NetworkManager.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/lib/mangmi/firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
