// Mangmi Clean Linux: the person holding the console may update it
// (mangmi-update / ES-DE "System Update") and add the optional software of
// /usr/share/mangmi/optional.list (mangmi-update --add, ES-DE "Install - ...")
// without typing a password. mangmi-update --install accepts only names
// from that list.
polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit");
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (unit == "mangmi-update.service" || /^mangmi-install@[a-z0-9-]+\.service$/.test(unit)) &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
