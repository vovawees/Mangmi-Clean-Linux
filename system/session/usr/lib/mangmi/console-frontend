#!/bin/bash
# Runs inside the console sway session: keeps the frontend on screen.
# Quitting ES-DE simply restarts it; "Desktop Mode" in the Mangmi system leaves.
fails=0
while :; do
  start=$SECONDS
  if command -v es-de >/dev/null; then
    es-de --no-splash
  else
    retroarch --menu
  fi
  [[ $(mangmi-mode get) == desktop ]] && { swaymsg exit; exit 0; }
  if ((SECONDS - start < 5)); then
    fails=$((fails + 1))
    if ((fails >= 3)); then
      echo "console-frontend: frontend keeps crashing, switching to desktop mode" >&2
      mangmi-mode desktop
      exit 1
    fi
  else
    fails=0
  fi
  sleep 0.5
done
