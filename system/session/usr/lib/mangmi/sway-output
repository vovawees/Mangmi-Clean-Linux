#!/bin/bash
# Sway output/input settings for the built-in portrait panel. The kernel reports
# the panel orientation through fbcon (same logic as ROCKNIX's sway session).
case "$(cat /sys/class/graphics/fbcon/rotate 2>/dev/null)" in
  1) t=90 ;;
  2) t=180 ;;
  3) t=270 ;;
  *) t=normal ;;
esac
found=0
for c in /sys/class/drm/card*-DSI-*; do
  [[ -e $c ]] || continue
  name=${c##*/}
  name=${name#card*-}
  echo "output $name transform $t"
  echo "output $name bg #000000 solid_color"
  echo "input type:touch map_to_output $name"
  found=1
  break
done
((found)) || echo "# no DSI panel found"
