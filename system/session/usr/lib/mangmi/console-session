#!/bin/bash
# Console (game) mode: a minimal sway kiosk with ES-DE full screen.
export XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=mangmi-console MANGMI_MODE=console
export QT_QPA_PLATFORM="wayland;xcb" MOZ_ENABLE_WAYLAND=1 _JAVA_AWT_WM_NONREPARENTING=1
run="$XDG_RUNTIME_DIR/mangmi"
mkdir -p "$run"
/usr/lib/mangmi/sway-output >"$run/sway-output.conf"
mangmi-input gamepad >/dev/null 2>&1 || :
exec sway -c /usr/share/mangmi/sway/console.conf
