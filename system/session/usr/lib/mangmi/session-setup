#!/bin/bash
# First-login defaults for the user (never overwrites existing files) and the
# "Mangmi Air X" tools system shown in ES-DE.
set -u
skel=/usr/share/mangmi/skel
[[ -d $skel ]] && cp -r --update=none "$skel/." "$HOME/" 2>/dev/null
chmod +x "$HOME"/Desktop/*.desktop 2>/dev/null

roms=${MANGMI_ROMS:-$HOME/ROMs}
mkdir -p "$roms" "$HOME/BIOS"
while read -r sys; do
  [[ -z $sys || $sys == \#* ]] || mkdir -p "$roms/$sys"
done </usr/share/mangmi/rom-systems.list 2>/dev/null

# Standalone emulators look for BIOS files in their own folders: point those
# at ~/BIOS too (unless the user has set them up already).
for d in "$HOME/.local/share/duckstation/bios" "$HOME/.config/PCSX2/bios" "$HOME/.config/ARMSX2/bios"; do
  [[ -e $d || -L $d ]] && continue
  mkdir -p "${d%/*}" && ln -s "$HOME/BIOS" "$d"
done
# RetroArch speaks the system language (set once; changeable in its menu)
ra="$HOME/.config/retroarch/retroarch.cfg"
if [[ -f $ra ]] && ! grep -q '^user_language' "$ra"; then
  lang=${LANG:-}
  [[ -n $lang ]] || lang=$(sed -n 's/^LANG=//p' /etc/locale.conf 2>/dev/null)
  case $lang in
    ru* | kk*) l=9 ;; uk*) l=26 ;; be*) l=32 ;; de*) l=4 ;; fr*) l=2 ;; es*) l=3 ;; it*) l=5 ;;
    pl*) l=14 ;; pt_BR*) l=7 ;; pt*) l=8 ;; tr*) l=18 ;; ja*) l=1 ;; ko*) l=10 ;;
    zh_TW* | zh_HK*) l=11 ;; zh*) l=12 ;; *) l=0 ;;
  esac
  printf 'user_language = "%s"\n' "$l" >>"$ra"
fi

# PPSSPP libretro core: fonts and UI atlas from the ppsspp-assets package
[[ -d /usr/share/ppsspp/assets && ! -e $HOME/BIOS/PPSSPP && ! -L $HOME/BIOS/PPSSPP ]] &&
  ln -s /usr/share/ppsspp/assets "$HOME/BIOS/PPSSPP"

# Default emulators where ES-DE's own first choice is not shipped (set once,
# changeable in ES-DE under Other settings -> Alternative emulators)
gl="$HOME/ES-DE/gamelists"
while IFS='|' read -r sys label; do
  [[ -z $sys || $sys == \#* || -z $label ]] && continue
  [[ -e $gl/$sys/gamelist.xml ]] && continue
  mkdir -p "$gl/$sys"
  printf '<?xml version="1.0"?>\n<alternativeEmulator>\n\t<label>%s</label>\n</alternativeEmulator>\n<gameList />\n' \
    "$label" >"$gl/$sys/gamelist.xml"
done </usr/share/mangmi/es-de/alternatives.list 2>/dev/null

# Mangmi tools: one script per entry, regenerated so updates reach the user
tools="$roms/mangmi"
mkdir -p "$tools"
stamp="$tools/.mangmi-generated"
if [[ ! -f $stamp || /usr/share/mangmi/es-de/tools.list -nt $stamp ]]; then
  find "$tools" -maxdepth 1 -name '*.sh' -exec grep -lZ '^# mangmi-generated' {} + 2>/dev/null | xargs -0 -r rm -f
  while IFS='|' read -r title cmd; do
    [[ -z $title || $title == \#* ]] && continue
    printf '#!/bin/bash\n# mangmi-generated\n%s\n' "$cmd" >"$tools/$title.sh"
    chmod +x "$tools/$title.sh"
  done </usr/share/mangmi/es-de/tools.list
  touch "$stamp"
fi
