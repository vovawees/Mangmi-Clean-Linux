# SPDX-License-Identifier: GPL-2.0-or-later
# Mangmi Clean Linux kernel configuration fragment.
# Merged on top of ROCKNIX's devices/SM6115/linux/linux.aarch64.conf.
# Every "=y"/"=m" line here is verified after olddefconfig by build-kernel.sh.

# --- identity / boot -----------------------------------------------------------
CONFIG_LOCALVERSION="-mangmi"
# CONFIG_LOCALVERSION_AUTO is not set
# Boot straight into the root filesystem: no initramfs is required
# (eMMC/SD, GPT, ext4 and vfat are built in). An external initrd still works.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Arch Linux ships firmware zstd-compressed (*.zst).
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- latency first -------------------------------------------------------------
# 1000 Hz tick: finer scheduling granularity for emulators and input.
# CONFIG_HZ_250 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_MC=y
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_PSI=y
# Fan modes move the "active" trip points at runtime (mangmi-hwd); device tree
# trip temperatures are writable by default since Linux 6.12.
CONFIG_THERMAL_GOV_BANG_BANG=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_THERMAL_STATISTICS=y

# --- memory ----------------------------------------------------------------------
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZSMALLOC=m
CONFIG_KSM=y

# --- storage / filesystems ---------------------------------------------------------
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=m
CONFIG_F2FS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=m
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- systemd / containers / sandboxes (Flatpak, browsers, Waydroid) -------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USER_NS=y
CONFIG_NAMESPACES=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
# pacman 7 sandboxes its downloader with Landlock (already first in CONFIG_LSM).
CONFIG_SECURITY_LANDLOCK=y

# --- networking: hotspot / connection sharing (NetworkManager uses nftables) ------
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_WIREGUARD=m
CONFIG_TUN=y

# --- input / gaming -----------------------------------------------------------------
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_UHID=y
CONFIG_HIDRAW=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=y
CONFIG_NINTENDO_FF=y
CONFIG_HID_STEAM=m
CONFIG_HID_MICROSOFT=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_BT_HIDP=m
CONFIG_NTSYNC=y
CONFIG_JOYSTICK_MANGMI=m

# --- device essentials (Mangmi Air X) ------------------------------------------------
CONFIG_DRM_MSM=y
CONFIG_LEDS_AW200XX=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_SENSORS_GPIO_FAN=m
CONFIG_INPUT_PWM_VIBRA=m
CONFIG_ATH10K_SNOC=m
CONFIG_SND_USB_AUDIO=y
