_units="mangmi-hwd.service mangmi-firstboot.service mangmi-pacman-init.service"

post_install() {
  systemctl preset $_units >/dev/null 2>&1 || :
  systemctl --global preset mangmi-hotkeyd.service >/dev/null 2>&1 || :
  [ -f /boot/Image-mangmi ] && mangmi-boot-update >/dev/null 2>&1 || :
}

post_upgrade() {
  # systems installed before mangmi-esp: no /boot automount (from the next boot)
  mangmi-esp fstab >/dev/null 2>&1 || :
  systemctl --global preset mangmi-hotkeyd.service >/dev/null 2>&1 || :
  systemctl try-restart mangmi-hwd.service >/dev/null 2>&1 || :
  udevadm control --reload >/dev/null 2>&1 || :
}
